{
  "name": "projects",
  "version": "1.0.0",
  "description": "Vanilla TypeScript application with Express + Vite (HTML + CSS + TS + Node API)",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsup server/server.ts --format cjs --platform node --target node20 --outDir dist-server --no-splitting --no-minify",
    "dev": "vite",
    "lint": "eslint",
    "start": "node dist-server/server.js",
    "ts-check": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "autoprefixer": "^10.4.20",
    "coze-coding-dev-sdk": "^0.7.21",
    "esbuild": "^0.27.2",
    "eslint": "^9",
    "only-allow": "^1.2.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8",
    "vite": "^7.2.4"
  }
}
